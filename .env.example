# ==============================================================================
# J.A.R.V.I.S. CONFIGURATION — CHATBOT & WIRELESS SMART PLUG CONTROLLER
# ==============================================================================

# --- AI BRAIN API KEYS (Groq recommended for blazingly fast responses) ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- HARDWARE SETUP (TP-Link Tapo & Kasa Plugs / Bulbs) ---
# IP Address of your plug or bulb on your local Wi-Fi (e.g. 192.168.1.50)
SMART_PLUG_IP=192.168.1.100

# Tapo Cloud / App Login (Required for Tapo KLAP AES encryption on P100, P110, L530E)
# Leave blank if using legacy Kasa plugs (KP105, KP115, HS100) which do not require login.
TAPO_USERNAME=your_tapo_email@example.com
TAPO_PASSWORD=your_tapo_password_here

# --- SERVER CONFIGURATION ---
PORT=8000
HOST=127.0.0.1
